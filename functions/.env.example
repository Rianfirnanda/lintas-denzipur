# Salin menjadi functions/.env sebelum deploy. Jangan isi rahasia di sini.
# ID database Firestore. Project lintas-denzipur memakai database default.
DZ_DATABASE=(default)
# Region Functions; samakan dengan lokasi database (Jakarta = asia-southeast2).
DZ_REGION=asia-southeast2
# Email (dipisah koma) yang otomatis menjadi administrator sistem saat login pertama (email Google terverifikasi).
DZ_BOOTSTRAP_ADMINS=admin@example.com
# App Check: biarkan false (mode monitor) sampai semua klien memakai App Check.
DZ_ENFORCE_APP_CHECK=false
